script/source = "extends Bullet

func dash_destroy() -> void:
	var particle = preload(\"uid://cdqwhvvaey7b\").instantiate()
	owner.get_parent().add_child(particle)
	particle.global_position = global_position
	particle.emitting = true
	particle.finished.connect(particle.queue_free)
	Sound.play(preload(\"uid://cnphesftixd4d\"),0.5) # snd_prophecy_break
	Sound.play(preload(\"uid://bnsemkohtkywv\"),0.2) # snd_paperbreak
	queue_free()
"

