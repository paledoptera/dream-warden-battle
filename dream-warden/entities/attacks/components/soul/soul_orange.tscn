[sub_resource type="GDScript" id="GDScript_ooxh1"]
resource_name = "OrangeDots"
script/source = "extends Node2D

@onready var soul: SoulOrange = get_parent()

var base_offset: float = 35.0
var offset: float = 0.0

func _process(delta: float) -> void:
	rotate(5.0 * delta)
	
	
	modulate = lerp(Color(\"ffffff00\"),Color(\"ffffff\"),max(soul.charge_timer-2.0,0.0)/16.0)
	
	match soul.dash_state:

		soul.DashState.CHARGING:
			visible = true
			offset = lerp(base_offset,0.0,soul.charge_timer/16.0)
		_:
			visible = false
			
	
	var rot = 0.0
	
	
	
	for i in get_children():
		
		rot += 90.0
		print(\"ROT = \", rot)
		i.position = Vector2(0.0,offset).rotated(deg_to_rad(rot))
		i.scale = (Vector2.ONE - (Vector2.ONE * soul.charge_timer)/32) * 4.0
		
		i.global_rotation = 0.0
"

[sub_resource type="GDScript" id="GDScript_pdi44"]
resource_name = "SuperHeart"
script/source = "extends Sprite2D
@onready var soul: SoulOrange = get_parent()

var siner = 0.0

func _process(delta: float) -> void:
	match soul.dash_state:
		soul.DashState.CHARGING:
			if soul.charge_timer == 16.0:
				visible = true
				siner += delta
				var alpha = 0.75 + Siner.get_sine(siner,0.5,20.0)
				print(\"ALPHA \", alpha)
				modulate.a = alpha
			
		_:
			visible = false
			siner = 0.0
		
"

[sub_resource type="GDScript" id="GDScript_jwwtx"]
resource_name = "SuperHeartSmall"
script/source = "extends Sprite2D
@onready var soul: SoulOrange = get_parent()
var siner = 0.0

func _process(delta: float) -> void:
	match soul.dash_state:
		soul.DashState.DASHING:
			visible = true
			siner += delta
			var alpha = 0.5 + Siner.get_sine(siner,0.5,40.0)
			modulate.a = alpha
			
		_:
			visible = false
			siner = 0.0
		
"

