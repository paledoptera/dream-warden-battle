[sub_resource type="GDScript" id="GDScript_q7cek"]
resource_name = "FlameEffect"
script/source = "extends AnimatedSprite2D

@export var anim: AnimationPlayer
var prev_state

@onready var soul: SoulOrange = get_owner()

func _process(delta: float) -> void:
	if soul.dash_state != prev_state and soul.dash_state == soul.DashState.DASHING:
		if anim:
			anim.play(\"dash\")

	if soul.dash_state == soul.DashState.DASHING:
		visible = true
	else:
		visible = false

	prev_state = soul.dash_state
"

[sub_resource type="GDScript" id="GDScript_vpd5p"]
resource_name = "Charge"
script/source = "extends AudioStreamPlayer

@onready var soul: SoulOrange = get_parent()

func _process(delta: float) -> void:
	if soul.dash_state == soul.DashState.CHARGING:
		if not playing:
			playing = true
		pitch_scale = min(0.25 + (soul.charge_timer * 0.05),1)
		print(\"TEST\", linear_to_db(0.5))
					#snd_pitch(loop_sound, min(0.5 + (chargetimer * 0.05), 1));
	else:
		playing = false
"

